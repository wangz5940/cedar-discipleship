PORT=5114
HOST=0.0.0.0
DATABASE_PATH=./data/app.json
RECORDS_PATH=./data/records.json
RECORDS_BACKUP_ENABLED=true
RECORDS_BACKUP_DIR=./data/record-backups
RECORDS_BACKUP_LIMIT=120
SESSION_SECRET=please-change-this-to-a-long-random-string

ABSENCE_ALERT_ENABLED=false
ABSENCE_ALERT_TO=your-gmail-address@gmail.com
ABSENCE_ALERT_DAYS=3
ABSENCE_ALERT_HOUR=21
ABSENCE_ALERT_TIMEZONE=Asia/Shanghai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Preferred multi-robot configuration. Tokens remain server-side.
# JSON: {"primary":{"name":"Primary bot","token":"123:secret","groups":{"1":{"chat_id":12345678,"chat_type":3}}}}
# Robots added from the super-admin page are persisted in ${AGP_NOTIFICATION_DIR}/robots.json.
AGP_POTATO_ROBOTS=
# SHA-256 digest of the account unlock key for OVCM courses and favorites. Empty keeps entries hidden.
AGP_OVCM_ACCESS_KEY_SHA256=

# Legacy single-robot configuration. Used only when AGP_POTATO_ROBOTS is empty.
AGP_POTATO_BOT_TOKEN=
# JSON: {"study_group_id":{"chat_id":12345678,"chat_type":2}}
# chat_type: 2 = group, 3 = supergroup; use the type returned by Potato.
# Optional first-run seed. Later bindings are managed by the super-admin UI.
AGP_POTATO_GROUPS=
